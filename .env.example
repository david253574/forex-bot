# Forex AI Trading System - Environment Configuration
# Copy this file to .env to customize operational settings without modifying code.

# Operating Mode: 'practice' (default demo), 'live' (real capital), or 'mock' (local simulator)
TRADING_MODE=practice

# Safety Lock: Must be explicitly set to 'true' to allow starting in 'live' mode
ALLOW_LIVE_TRADING=false

# Web Dashboard Port
DASHBOARD_PORT=8080

# Supabase / PostgreSQL Database URL (Optional - defaults to local SQLite if omitted)
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=

# AES-128 Fernet Key for encrypting user OANDA API tokens at rest (32 url-safe base64 bytes)
# If left empty, an automatic project seed key is generated locally.
CREDENTIAL_ENCRYPTION_KEY=

# Graceful shutdown wait timeout in seconds before escalation
SHUTDOWN_TIMEOUT=15

# Optional OANDA API credential overrides (overrides broker_config.json if set)
# OANDA_API_TOKEN=your_token_here
# OANDA_ACCOUNT_ID=your_account_id_here

# Finnhub Economic Calendar API Key (for Macro News Blackout Shield)
FINNHUB_API_KEY=

# Google Gemini API Configuration (for Market Intelligence & Copilot)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_PROVIDER=gemini
